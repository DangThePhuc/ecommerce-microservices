          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 + danh sách sản phẩm', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().items).to.be.an('array').that.is.not.empty; });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "TC-CUS-04 Lấy thông tin Membership",
      "item": [
        {
          "name": "GET /api/customers/:uid",
          "request": {
            "method": "GET",
            "header": [
