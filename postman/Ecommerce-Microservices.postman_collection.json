                "{{uid}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 + mname, score', () => { pm.response.to.have.status(200); const m = pm.response.json().membership; pm.expect(m.mname).to.eql('Normal'); pm.expect(m.score).to.eql(10); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "TC-CUS-05 Truy vấn Customer không có token",
