# Sao chép file này thành .env rồi chỉnh sửa:  cp .env.example .env
# File .env đã được liệt kê trong .gitignore -> KHÔNG được commit lên GitHub.
# Nếu không có .env, docker-compose dùng các giá trị mặc định (chỉ dành cho môi trường dev).

GATEWAY_PORT=8080

# Database
POSTGRES_PASSWORD=postgres

# JWT (đổi thành chuỗi ngẫu nhiên dài khi triển khai thật)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=3600

# Tài khoản seed (tạo tự động khi Auth Service khởi động)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
STAFF_USERNAME=staff
STAFF_PASSWORD=Staff@123

# API Gateway (Redis)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SEC=60
CACHE_TTL_SEC=30
